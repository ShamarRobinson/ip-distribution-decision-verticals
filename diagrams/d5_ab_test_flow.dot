digraph G { rankdir=LR;   bgcolor="#fcfcfb"; pad=0.3; nodesep=0.35; ranksep=0.45;
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=12, color="#c9c8c2", fillcolor="#ffffff", fontcolor="#0b0b0b", penwidth=1.2, margin="0.18,0.10"];
  edge [fontname="Inter", fontsize=10.5, color="#8a8984", fontcolor="#52514e", penwidth=1.3, arrowsize=0.7];

  labelloc=t; label=<<b>A/B test workflow for distribution decisions</b>>; fontname="Inter"; fontsize=16;
  a [label="Hypothesis\n\"A lower price lifts\nunit sales enough\nto raise profit\""];
  b [label="Primary metric\nnet royalty per\nproduct-page visitor"];
  c [label="Breakeven lift\n(control net / variant net) - 1\ne.g. 21.4%", fillcolor="#e8f0fb", color="#2a78d6"];
  d [label="Sample size\nalpha 0.05, power 0.80\n~18,467 visitors/arm"];
  e [label="Run\nfixed duration,\nno peeking"];
  f [label="Decide\nship variant only if\nlift > breakeven lift\nand CI excludes it", fillcolor="#e6f3e6", color="#008300"];
  a->b->c->d->e->f;
}