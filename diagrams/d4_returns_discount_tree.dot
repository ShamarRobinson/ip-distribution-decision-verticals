digraph G { rankdir=TB;   bgcolor="#fcfcfb"; pad=0.3; nodesep=0.35; ranksep=0.45;
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=12, color="#c9c8c2", fillcolor="#ffffff", fontcolor="#0b0b0b", penwidth=1.2, margin="0.18,0.10"];
  edge [fontname="Inter", fontsize=10.5, color="#8a8984", fontcolor="#52514e", penwidth=1.3, arrowsize=0.7];

  labelloc=t; label=<<b>Decision tree: wholesale discount and returnability (IngramSpark)</b>>; fontname="Inter"; fontsize=16;
  q1 [label="Is physical bookstore\nshelf placement a goal?", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  q2 [label="Can you fund a returns reserve?\n(returns can exceed earnings;\n180-day tail if you switch)", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  o1 [label="55% discount, returnable\n$3.33 net per $16.99 unit\nHighest reach, highest risk", fillcolor="#fdeee7", color="#eb6834"];
  o2 [label="55% discount, non-returnable\n$3.33 net, no return exposure\nStores may not stock it", fillcolor="#fdf4df", color="#eda100"];
  o3 [label="35 to 40% discount, non-returnable\n$5.87 net at 40%\nOnline wholesale only", fillcolor="#e8f0fb", color="#2a78d6"];
  q1 -> q2 [label="  Yes"]; q1 -> o3 [label="  No"];
  q2 -> o1 [label="  Yes"]; q2 -> o2 [label="  No"];
}