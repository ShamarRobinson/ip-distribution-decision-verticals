digraph G { rankdir=TB; bgcolor="#fcfcfb"; pad=0.3; nodesep=0.35; ranksep=0.5;
labelloc=t; label=<<b>Decision tree: which distribution stack fits your business type?</b>>; fontname="Inter"; fontsize=16;
node [fontname="Inter", fontsize=12, penwidth=1.3]; edge [fontname="Inter", fontsize=10.5, arrowsize=0.75];
q1 [label="Where will most
buyers come from?", shape=diamond, style=filled, fillcolor="#f0efec", color="#c9c8c2", fontcolor="#0b0b0b", margin="0.04,0.04", penwidth=1.2];
q2 [label="Need bookstore or
library placement?", shape=diamond, style=filled, fillcolor="#f0efec", color="#c9c8c2", fontcolor="#0b0b0b", margin="0.04,0.04", penwidth=1.2];
q3 [label="Selling more than ~17 of
each format a month?", shape=diamond, style=filled, fillcolor="#f0efec", color="#c9c8c2", fontcolor="#0b0b0b", margin="0.04,0.04", penwidth=1.2];
q4 [label="Do you own an audience?
(email list, events,
clients, students)", shape=diamond, style=filled, fillcolor="#f0efec", color="#c9c8c2", fontcolor="#0b0b0b", margin="0.04,0.04", penwidth=1.2];
A [label="A. Independent creator
KDP print + ebook", shape=box, style="rounded,filled", fillcolor="#e8f0fb", color="#2a78d6", fontcolor="#0b0b0b", margin="0.18,0.1", penwidth=1.3];
B [label="B. Small press or imprint
KDP + IngramSpark", shape=box, style="rounded,filled", fillcolor="#fdeee7", color="#eb6834", fontcolor="#0b0b0b", margin="0.18,0.1", penwidth=1.3];
C [label="C. Catalog or backlist owner
KDP + PublishDrive", shape=box, style="rounded,filled", fillcolor="#fcecf2", color="#e87ba4", fontcolor="#0b0b0b", margin="0.18,0.1", penwidth=1.3];
D [label="D. Brand, educator or
corporate IP owner
Own store (Lulu Direct) + KDP", shape=box, style="rounded,filled", fillcolor="#fdf4df", color="#eda100", fontcolor="#0b0b0b", margin="0.18,0.1", penwidth=1.3];
E [label="E. Wide ebook strategist
KDP + Draft2Digital or
direct Apple / Kobo / B&N", shape=box, style="rounded,filled", fillcolor="#e3f5ee", color="#1baf7a", fontcolor="#0b0b0b", margin="0.18,0.1", penwidth=1.3];
q1 -> q2 [label="Stores and
online retail", color="#8a8984", fontcolor="#0b0b0b", penwidth=1.3];
q1 -> q4 [label="My own
channels", color="#8a8984", fontcolor="#0b0b0b", penwidth=1.3];
q2 -> A [label="No, Amazon
is enough", color="#8a8984", fontcolor="#0b0b0b", penwidth=1.3];
q2 -> q3 [label="Yes", color="#8a8984", fontcolor="#0b0b0b", penwidth=1.3];
q3 -> B [label="No", color="#8a8984", fontcolor="#0b0b0b", penwidth=1.3];
q3 -> C [label="Yes", color="#8a8984", fontcolor="#0b0b0b", penwidth=1.3];
q4 -> D [label="Yes", color="#8a8984", fontcolor="#0b0b0b", penwidth=1.3];
q4 -> E [label="No,
ebook-led", color="#8a8984", fontcolor="#0b0b0b", penwidth=1.3];
}