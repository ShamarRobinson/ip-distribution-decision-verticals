digraph G { rankdir=TB;   bgcolor="#fcfcfb"; pad=0.3; nodesep=0.35; ranksep=0.45;
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=12, color="#c9c8c2", fillcolor="#ffffff", fontcolor="#0b0b0b", penwidth=1.2, margin="0.18,0.10"];
  edge [fontname="Inter", fontsize=10.5, color="#8a8984", fontcolor="#52514e", penwidth=1.3, arrowsize=0.7];

  labelloc=t; label=<<b>Decision tree: which distribution stack fits your business type?</b>>; fontname="Inter"; fontsize=16;
  q1 [label="Where will most buyers come from?", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  q2 [label="Need bookstore or\nlibrary placement?", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  q3 [label="Expected volume above\n17 units/format/month?", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  q4 [label="Own audience?\n(email list, events,\nclients, students)", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  v1 [label="Vertical A: Independent creator\nKDP print + ebook\n(+ KDP Select if exclusive)\nBreakeven ~158 unit pairs", fillcolor="#e8f0fb", color="#2a78d6"];
  v2 [label="Vertical B: Small press / imprint\nKDP for Amazon\n+ IngramSpark for wholesale\n(55% discount, returnable)", fillcolor="#fdeee7", color="#eb6834"];
  v3 [label="Vertical C: Catalog / backlist owner\nKDP for Amazon\n+ PublishDrive subscription\n(volume beats the flat fee)", fillcolor="#fcecf2", color="#e87ba4"];
  v4 [label="Vertical D: Brand, educator,\nor corporate IP owner\nLulu Direct / own store\n+ KDP for discovery", fillcolor="#fdf4df", color="#eda100"];
  v5 [label="Vertical E: Wide ebook strategy\nKDP (Kindle) + Draft2Digital\nor direct Apple / Kobo / B&N", fillcolor="#e6f3e6", color="#008300"];
  q1 -> q2 [label="  Retail stores & online"];
  q1 -> q4 [label="  My own channels"];
  q2 -> v1 [label="  No, Amazon is enough"];
  q2 -> q3 [label="  Yes"];
  q3 -> v2 [label="  No"];
  q3 -> v3 [label="  Yes"];
  q4 -> v4 [label="  Yes"];
  q4 -> v5 [label="  No, ebook-led"];
}