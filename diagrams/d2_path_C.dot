digraph G { rankdir=TB; bgcolor="#fcfcfb"; pad=0.3; nodesep=0.35; ranksep=0.5;
labelloc=t; label=<<b>Your Path Through the Decision Tree: Vertical C</b>>; fontname="Inter"; fontsize=16;
node [fontname="Inter", fontsize=12, penwidth=1.3]; edge [fontname="Inter", fontsize=10.5, arrowsize=0.75];
q1 [label="Where Will Most
Buyers Come From?", shape=diamond, style=filled, fillcolor="#fff6dc", color="#e87ba4", fontcolor="#0b0b0b", margin="0.04,0.04", penwidth=2.4];
q2 [label="Need Bookstore Or
Library Placement?", shape=diamond, style=filled, fillcolor="#fff6dc", color="#e87ba4", fontcolor="#0b0b0b", margin="0.04,0.04", penwidth=2.4];
q3 [label="Selling More than ~17 Of
Each Format a Month?", shape=diamond, style=filled, fillcolor="#fff6dc", color="#e87ba4", fontcolor="#0b0b0b", margin="0.04,0.04", penwidth=2.4];
q4 [label="Do You Own an Audience?
(Email List, Events,
Clients, Students)", shape=diamond, style=filled, fillcolor="#f0efec", color="#c9c8c2", fontcolor="#b0afa9", margin="0.04,0.04", penwidth=1.2];
A [label="A. Independent Creator
KDP Print + Ebook", shape=box, style="rounded,filled", fillcolor="#f6f6f4", color="#dedcd6", fontcolor="#b0afa9", margin="0.18,0.1", penwidth=1.3];
B [label="B. Small Press or Imprint
KDP + IngramSpark", shape=box, style="rounded,filled", fillcolor="#f6f6f4", color="#dedcd6", fontcolor="#b0afa9", margin="0.18,0.1", penwidth=1.3];
C [label="C. Catalog or Backlist Owner
KDP + PublishDrive", shape=box, style="rounded,filled", fillcolor="#fcecf2", color="#e87ba4", fontcolor="#0b0b0b", margin="0.18,0.1", penwidth=3];
D [label="D. Brand, Educator Or
Corporate IP Owner
Own Store (Lulu Direct) + KDP", shape=box, style="rounded,filled", fillcolor="#f6f6f4", color="#dedcd6", fontcolor="#b0afa9", margin="0.18,0.1", penwidth=1.3];
E [label="E. Wide Ebook Strategist
KDP + Draft2Digital Or
Direct Apple / Kobo / B&N", shape=box, style="rounded,filled", fillcolor="#f6f6f4", color="#dedcd6", fontcolor="#b0afa9", margin="0.18,0.1", penwidth=1.3];
q1 -> q2 [label="Stores and
online retail", color="#e87ba4", fontcolor="#0b0b0b", penwidth=3.2];
q1 -> q4 [label="My own
channels", color="#dedcd6", fontcolor="#c9c8c2", penwidth=1.3];
q2 -> A [label="No, Amazon
is enough", color="#dedcd6", fontcolor="#c9c8c2", penwidth=1.3];
q2 -> q3 [label="Yes", color="#e87ba4", fontcolor="#0b0b0b", penwidth=3.2];
q3 -> B [label="No", color="#dedcd6", fontcolor="#c9c8c2", penwidth=1.3];
q3 -> C [label="Yes", color="#e87ba4", fontcolor="#0b0b0b", penwidth=3.2];
q4 -> D [label="Yes", color="#dedcd6", fontcolor="#c9c8c2", penwidth=1.3];
q4 -> E [label="No,
ebook-led", color="#dedcd6", fontcolor="#c9c8c2", penwidth=1.3];
