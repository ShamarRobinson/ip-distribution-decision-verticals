digraph G { rankdir=TB;   bgcolor="#fcfcfb"; pad=0.3; nodesep=0.35; ranksep=0.45;
  node [shape=box, style="rounded,filled", fontname="Inter", fontsize=12, color="#c9c8c2", fillcolor="#ffffff", fontcolor="#0b0b0b", penwidth=1.2, margin="0.18,0.10"];
  edge [fontname="Inter", fontsize=10.5, color="#8a8984", fontcolor="#52514e", penwidth=1.3, arrowsize=0.7];

  labelloc=t; label=<<b>Decision tree: ebook exclusivity (KDP Select) vs. going wide</b>>; fontname="Inter"; fontsize=16;
  q1 [label="Is the work in a genre where\nKindle Unlimited readers concentrate?", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  q2 [label="Can you tolerate a variable\npool payout? (CV ~6%/month)", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  q3 [label="Do you have non-Amazon demand?\n(libraries, Apple, Kobo, international)", shape=diamond, style="filled", fillcolor="#f0efec", margin="0.05,0.05"];
  o1 [label="Option 1: Exclusive\nEnroll ebook in KDP Select (90-day term)\nRe-evaluate each term as an A/B period", fillcolor="#e8f0fb", color="#2a78d6"];
  o2 [label="Option 2: Wide\nKDP + Draft2Digital or direct stores\n$3.14 to $3.49 net per $4.99 ebook", fillcolor="#e6f3e6", color="#008300"];
  o3 [label="Option 3: Hybrid catalog\nSome titles exclusive, some wide\n(32% of surveyed authors do this)", fillcolor="#fcecf2", color="#e87ba4"];
  q1 -> q2 [label="  Yes"]; q1 -> q3 [label="  No"];
  q2 -> o1 [label="  Yes"]; q2 -> o3 [label="  Unsure"];
  q3 -> o2 [label="  Yes"]; q3 -> o3 [label="  Some"];
}